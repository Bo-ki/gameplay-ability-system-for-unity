<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <NormalizedRowsOutputRoot>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\SourceGenCandidate</NormalizedRowsOutputRoot>
    <NormalizedRowsSource>$(NormalizedRowsOutputRoot)\Editor\LubanNormalizedRows.gen.cs</NormalizedRowsSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\IGasCodeGenPhase.cs" Link="CodeGen\Core\IGasCodeGenPhase.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasCodeGenContext.cs" Link="CodeGen\Core\GasCodeGenContext.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasCodeGenSemanticIdentity.cs" Link="CodeGen\Core\GasCodeGenSemanticIdentity.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\AutoChessDemoConfigModel.cs" Link="CodeGen\Core\AutoChessDemoConfigModel.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasCodeGenManifest.cs" Link="CodeGen\Core\GasCodeGenManifest.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasCodeGenPackageDescriptor.cs" Link="CodeGen\Core\GasCodeGenPackageDescriptor.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasCodeGenInstallEnvelope.cs" Link="CodeGen\Core\GasCodeGenInstallEnvelope.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasCodeGenCandidateWorkspace.cs" Link="CodeGen\Core\GasCodeGenCandidateWorkspace.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasCodeGenGenerationStore.cs" Link="CodeGen\Core\GasCodeGenGenerationStore.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasCodeGenCandidateCompileGate.cs" Link="CodeGen\Core\GasCodeGenCandidateCompileGate.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasRowScanner.cs" Link="CodeGen\Core\GasRowScanner.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\LubanNormalizedRowBootstrap.cs" Link="CodeGen\Core\LubanNormalizedRowBootstrap.cs" />
    <Compile Include="$(NormalizedRowsSource)" Link="CodeGen\Generated\LubanNormalizedRows.gen.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\RowMetadata.cs" Link="CodeGen\Core\RowMetadata.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\GasDefinitionKind.cs" Link="CodeGen\Core\GasDefinitionKind.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Core\RowMetadataFactory.cs" Link="CodeGen\Core\RowMetadataFactory.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\GasCodeGenPipeline.cs" Link="CodeGen\GasCodeGenPipeline.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Phases\GasGlueCodeGenPhases.cs" Link="CodeGen\Phases\GasGlueCodeGenPhases.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\CodeGen\Phases\AutoChessDemoCodeGenPhase.cs" Link="CodeGen\Phases\AutoChessDemoCodeGenPhase.cs" />
    <Compile Include="..\..\Assets\GAS\Editor\General\IndentedWriter.cs" Link="CodeGen\IndentedWriter.cs" />
  </ItemGroup>
  <Target Name="GenerateLubanNormalizedRows" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\LubanNormalizedRowBootstrap\LubanNormalizedRowBootstrap.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
    <Exec Command="dotnet run --no-build --project &quot;..\LubanNormalizedRowBootstrap\LubanNormalizedRowBootstrap.csproj&quot; -- --projectRoot &quot;$(MSBuildProjectDirectory)\..\..&quot; --outputRoot &quot;$(NormalizedRowsOutputRoot)&quot;" />
  </Target>
</Project>
