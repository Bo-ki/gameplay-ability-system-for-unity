  "CaseSet": [
    {
      "CaseId": "TT-01",
      "Name": "BaselineAuthority",
      "Purpose": "Seal exact content-addressed archives, capture the cold baseline, and prove post-seal authority bytes remain event-level immutable.",
      "RequiredEvidenceKinds": [
        "AuthoritySnapshot",
        "AuthorityWatcherLog"
      ]
    },
    {
      "CaseId": "TT-02",
      "Name": "SelectorAtomicKill",
      "Purpose": "Inject bounded kills around the complete-manifest replace and prove the selector is always an intact old or new file.",
      "RequiredEvidenceKinds": [
        "ManifestSnapshot",
        "ProcessLog"
      ]
    },
    {
      "CaseId": "TT-03",
      "Name": "ResolveKillRecovery",
      "Purpose": "Kill during Unity or UPM resolve, restart, and prove Runtime, Editor, and AutoChess converge to the manifest-selected generation.",
      "RequiredEvidenceKinds": [
        "UnityObservation",
        "ProcessLog"
      ]
    },
    {
      "CaseId": "TT-04",
      "Name": "MissingCorruptAuthority",
      "Purpose": "Remove or corrupt the selected archive and prove direct Unity fails closed without consuming cache as authority.",
      "RequiredEvidenceKinds": [
        "FaultInjectionRecord",
        "UnityObservation"
      ]
    },
    {
      "CaseId": "TT-05",
      "Name": "ManifestLockDrift",
      "Purpose": "Inject manifest, lock, and audit drift while preserving manifest as the sole Unity-consumed selector.",
      "RequiredEvidenceKinds": [
        "ManifestSnapshot",
        "PackageLockSnapshot",
        "AuditRecordSnapshot"
      ]
    },
    {
      "CaseId": "TT-06",
      "Name": "StaleCacheBeeRsp",
      "Purpose": "Preseed stale PackageCache, Bee, and response-file state and prove none can determine the final generation.",
      "RequiredEvidenceKinds": [
        "CacheSnapshot",
        "BeeRspSnapshot",
        "UnityObservation"
      ]
    },
    {
      "CaseId": "TT-07",
      "Name": "BoundaryCleanup",
      "Purpose": "Reject hardlink or reparse boundary attacks, clean only suite-owned objects, and preserve the protected project snapshot.",
      "RequiredEvidenceKinds": [
        "FilesystemBoundaryRecord",
        "CleanupRecord",
        "ProtectedSnapshot"
      ]
    },
    {
      "CaseId": "TT-08",
      "Name": "EvidenceClosure",
      "Purpose": "Persist a raw evidence closure whose referenced files remain openable and whose lengths and SHA-256 values bind their original bytes.",
      "RequiredEvidenceKinds": [
        "EvidenceClosure"
      ]
    }
  ],
